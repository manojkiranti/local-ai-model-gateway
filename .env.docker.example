# ============ Local LLM Gateway — configuration for docker compose ============
# Copy to `.env.docker` and fill in secrets. Never commit `.env.docker`.
#
# Difference vs the plain .env.example: hostnames are container-network aware.
#   - DATABASE_URL host is `db` (the compose service), NOT 127.0.0.1.
#   - OLLAMA_BASE_URL points at the HOST's Ollama via host.docker.internal
#     (compose maps this to the host gateway; see docker-compose.yml extra_hosts).

# --- Database (must match the db service creds in docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev_pw@db:5432/local_ai_gateway
# Postgres container reads this; keep it EQUAL to the password in DATABASE_URL.
POSTGRES_PASSWORD=gateway_dev_pw

# --- Auth / JWT ---
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAILS=

# --- Ollama (runs on the HOST, reached from inside the container) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=120
DEFAULT_CHAT_MODEL=qwen2.5:latest
DEFAULT_EMBED_MODEL=nomic-embed-text:latest

# --- Agent ---
AGENT_MODEL=qwen2.5:latest
AGENT_TEMPERATURE=0.1
AGENT_NUM_CTX=16384
AGENT_MAX_ITERATIONS=8

# --- Remote MCP server (blank = local tools only). If it runs on the host too,
#     use host.docker.internal; if it's another compose service, use its name. ---
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TOOL_MODE=read_only
MCP_TOOL_ALLOWLIST=
MCP_READ_PREFIXES=get,list,search,read,fetch,find,view
MCP_WRITE_KEYWORDS=create,update,delete,send,remove,archive,associate,advance,propose,apply,register

# --- Files (mount a volume at this path in compose to persist them) ---
FILES_DIR=generated_files

# --- CORS ---
CORS_ORIGINS=*
