# ============ Local LLM Gateway — configuration for docker compose ============
# Copy to `.env.docker` and fill in secrets. Never commit `.env.docker`.
#
# Difference vs the plain .env.example: hostnames are container-network aware.
# Postgres and Ollama are EXTERNAL (not containerized), so every `localhost` in
# .env becomes `host.docker.internal` here — inside a container, localhost is the
# container itself. compose maps that name to the host (see extra_hosts).
# If the DB lives on another machine, use its real hostname/IP instead.

# --- Database (EXTERNAL Postgres — same server your .env points at) ---
# The host's PG must accept connections from the docker bridge network:
#   postgresql.conf: listen_addresses = '*'   (or the docker0 address)
#   pg_hba.conf:     host local_ai_gateway gateway 172.16.0.0/12 scram-sha-256
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME@host.docker.internal:5432/local_ai_gateway

# --- Auth / JWT ---
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAILS=

# --- Active Directory authentication ---
# Off by default. When true, AD_AUTH_BASE_URL is REQUIRED or the app refuses to
# start. This is the FULL .asmx service base — the /AD_Authentication method name
# is appended by the app, so DO NOT stop at the host:
#   RIGHT: http://10.10.0.66/IzoneAuth/service.asmx
#   WRONG: http://10.10.0.66/           (builds .../AD_Authentication at the site
#                                         root -> IIS 404 -> every login 503)
# The AD host is a LAN address reached DIRECTLY from the container — it is NOT
# rewritten to host.docker.internal the way Ollama/Postgres are, because it does
# not run on the docker host. If logins 503, first confirm the container can
# reach it:  docker compose exec gateway python -c "import httpx; \
#   print(httpx.get('http://10.10.0.66/IzoneAuth/service.asmx/AD_Authentication', \
#   params={'Username':'u','Password':'p'}, timeout=10).text)"
AD_AUTH_ENABLED=false
AD_AUTH_BASE_URL=
AD_AUTH_CONNECT_TIMEOUT=5.0
AD_AUTH_READ_TIMEOUT=10.0

# --- Login rate limiting ---
# Keep LOGIN_MAX_ATTEMPTS below the AD domain lockout threshold. Counters are per
# PROCESS, so N gateway workers = N x this limit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# --- Ollama (runs on the HOST, reached from inside the container) ---
# OLLAMA_BASE_URL is the EMBEDDINGS/reranker backend (it keeps its name).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=120
DEFAULT_CHAT_MODEL=qwen2.5:latest
DEFAULT_EMBED_MODEL=nomic-embed-text:latest

# AGENT_BASE_URL is the CHAT/agent backend, which may be a different server —
# vLLM on the GPU box. Blank (the default below) means "same server as
# embeddings" — same host-vs-container rule as OLLAMA_BASE_URL applies once you
# set it: a vLLM running on the HOST is reached from inside the container as
# http://host.docker.internal:<vllm_port> (NO trailing /v1 — OllamaClient
# appends /v1/chat/completions itself). See docs/ollama-to-vllm-migration.md.
AGENT_BASE_URL=

# --- Agent (hand-rolled tool-calling loop) ---
# NOTE: context length is NOT configured here. The /v1 API has no num_ctx, so it
# is set on the OLLAMA SERVICE, which is a different process with its own config.
# On the GPU server Ollama is a CONTAINER (nic_ollama, in the backend-local
# compose stack), so it goes in that service's `environment:`:
#   OLLAMA_CONTEXT_LENGTH: 32768
# then `docker compose up -d ollama` to RECREATE it — a running container's
# environment is fixed at launch, so editing compose without recreating (or
# exporting the var inside the container) changes nothing.
# An AGENT_NUM_CTX here is silently IGNORED (Settings has no such field and
# pydantic is configured extra="ignore") — it looks configured and is not.
# See docs/llm-transport-and-deployment.md.
AGENT_MODEL=qwen2.5:latest
AGENT_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=8

# --- Remote MCP server (blank = local tools only). Runs on the host too, so:
#     http://host.docker.internal:3333/mcp ---
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TOOL_MODE=read_only
MCP_TOOL_ALLOWLIST=
MCP_READ_PREFIXES=get,list,search,read,fetch,find,view
MCP_WRITE_KEYWORDS=create,update,delete,send,remove,archive,associate,advance,propose,apply,register

# --- Files (mount a volume at this path in compose to persist them) ---
FILES_DIR=generated_files
# Corpus documents (department RAG). MUST match between gateway and worker —
# both mount the same rag_documents volume at /app/rag_documents.
RAG_DOCS_DIR=rag_documents
# NRB blob store (Phase 5 downloads). MUST match between all three containers —
# nrb-runner WRITES it, worker reads it during recovery/ingest, and gateway reads
# it to serve a chat citation's source document. Since §28 an NRB file has no copy
# under RAG_DOCS_DIR, so this tree IS the corpus's bytes; all three mount the same
# nrb_files volume at /app/nrb_files. A relative value resolves to /app/nrb_files
# inside the image.
NRB_FILES_DIR=nrb_files
# The ingest worker refuses to start unless this embedding model is present on
# the Ollama host (docker compose cannot pull it): ollama pull qwen3-embedding:4b-q8_0

# --- External API (API-key callers: /v1/ocr, /v1/extract, /v1/api-keys) ---
# Off by default, so a container that never sets it is byte-identical to one
# built before the feature existed. READ ONCE AT PROCESS START: flipping this
# needs `docker compose up -d --force-recreate gateway`, not just an edit here.
# Every other knob (rate limits, upload caps, concurrency, key lockout) has a
# working default — see .env.example, which is the full catalogue; this file is
# only the container-network-aware delta.
EXTERNAL_API_ENABLED=false
#
# INSTALL_OCR deliberately has NO entry here, and adding one would not work.
# It is a docker-compose BUILD arg (docker-compose.yml -> build.args), fed from
# your SHELL or from .env.example — never from this file, which is `env_file`,
# i.e. the container's RUNTIME environment. To build with the OCR stack:
#     INSTALL_OCR=true docker compose build gateway nrb-runner
# Without it, POST /v1/ocr answers 503 for everything, and POST /v1/extract
# still serves PDF/DOCX/TXT/MD/JSON/XLSX/CSV normally — only IMAGE uploads to
# it 503, because only that path touches the OCR engine.

# --- CORS ---
CORS_ORIGINS=*
