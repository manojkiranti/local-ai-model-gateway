# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets
.env
.env.*
# ...but keep the committable templates (negations must follow the .env.* rule)
!.env.example
!.env.docker.example

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type-checkers and linters
.mypy_cache/
.ruff_cache/

# Packaging
build/
dist/
*.egg-info/

# Application-generated files (tool output, per-user uploads)
generated_files/

# RAG corpus documents (admin-uploaded PDFs/DOCX/CSVs + test-run artifacts).
# RAG_DOCS_DIR default; the DB row's storage_key points here. Never committed —
# these are ingested content, not source.
rag_documents/

# Subagent-driven-development scratch (ledgers, task briefs, review packages).
# Plans themselves live in docs/superpowers/plans/ and ARE committed.
.superpowers/

# Editors
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
