# ================= Local LLM Gateway — configuration =================
# Copy to .env and fill in. Never commit .env.

# --- Database (SQLAlchemy async URL) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME@127.0.0.1:5432/local_ai_gateway

# --- Auth / JWT ---
# REQUIRED. Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
#admin
# Admin bootstrap. If the users table is empty, the first registrant becomes
# admin automatically. Optionally force specific emails to admin (comma-sep):
ADMIN_EMAILS=

# --- Ollama (inference service) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
DEFAULT_CHAT_MODEL=qwen2.5:latest
DEFAULT_EMBED_MODEL=nomic-embed-text:latest

# --- Assistant identity (what the assistant calls itself) ---
# Product branding only. It stops the model answering "I am Qwen" and stops it
# inventing a training story, but it is NOT a security boundary: the real model
# id is still in the /v1/chat response body, and a determined user can elicit
# the base model by prompting. Leave ASSISTANT_ORG blank for no org clause.
ASSISTANT_NAME=NIC AI
ASSISTANT_ORG=NIC Bank

# --- Response transparency ("how it worked" in the UI) ---
# true  = /v1/chat and /v1/sessions/{id} return the execution trace (per
#         iteration: which tools ran, args, results) so the UI can show it.
# false = the trace is never sent to the client. Recommended in production.
# Either way the trace is still PERSISTED to chat_messages.trace for audit, and
# live tool_call/tool_result stream events still fire (the "using tool X"
# indicator) — this only hides the after-the-fact panel.
EXPOSE_TRACE=true

# --- Agent (hand-rolled tool-calling loop) ---
# NOTE: context length is NOT configured here. The /v1 API has no num_ctx, so it
# is set on the OLLAMA SERVICE itself, not in this gateway .env:
#   sudo systemctl edit ollama  ->  Environment="OLLAMA_CONTEXT_LENGTH=32768"
# (This gateway .env is read by the gateway; OLLAMA_CONTEXT_LENGTH is read by
#  Ollama — different process, different config file.)
# See docs/llm-transport-and-deployment.md.
# Local dev uses the small model; the GPU server sets qwen3.5:35b-a3b.
AGENT_MODEL=qwen2.5:latest
AGENT_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=8

# --- Remote MCP server (business tools; the gateway is the MCP client) ---
# Token is read from env only; never hardcoded, never logged. Blank = no auth.
# Leave MCP_SERVER_URL blank to run the agent with local tools only.
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
# Tool exposure policy: read_only (default) | allowlist | all
MCP_TOOL_MODE=read_only
MCP_TOOL_ALLOWLIST=
MCP_READ_PREFIXES=get,list,search,read,fetch,find,view
MCP_WRITE_KEYWORDS=create,update,delete,send,remove,archive,associate,advance,propose,apply,register

# --- Files (create_excel output; served only via GET /v1/files/{id} by UUID) ---
FILES_DIR=generated_files
# Spreadsheet upload (POST /v1/files): size cap on the wire, and the zip-bomb
# guard's ceiling on total uncompressed .xlsx content.
UPLOAD_MAX_BYTES=10485760
UPLOAD_XLSX_MAX_UNCOMPRESSED=209715200

# --- fetch_url tool (SSRF-guarded outbound HTTP GET) ---
# Internal/private IPs are ALWAYS blocked regardless of these settings.
# Set to false to disable the tool entirely.
FETCH_URL_ENABLED=true
# Optional: restrict fetches to these domains (and subdomains), comma-separated.
# Blank = any PUBLIC host allowed.
FETCH_URL_ALLOWLIST=

# --- Nepal Rastra Bank (get_nrb_forex tool) ---
# Official NRB Forex API base; the /rates path is hardcoded in app/nrb/client.py.
# The model never supplies a host for this tool.
NRB_API_BASE_URL=https://www.nrb.org.np/api/forex/v1
# Public website root, used ONLY by the manually-run sitemap inventory
# (scripts/nrb_sitemap_inventory.py). Its host is the discovery trust boundary:
# any sitemap or URL on another host is reported and skipped, never fetched.
NRB_SITE_BASE_URL=https://www.nrb.org.np
# Pause between requests during NRB discovery (REST enumeration, page probes) and
# between file downloads. Politeness pacing for a central bank's public site; 0
# disables it.
NRB_CRAWL_DELAY_SECONDS=0.25
# Where scripts/nrb_fetch.py stores downloaded NRB attachments. SEPARATE from
# RAG_DOCS_DIR: raw upstream artefacts, not department corpus documents. Layout is
# content-addressed (<sha256[:2]>/<sha256>.<ext>), so identical bytes republished
# under two URLs occupy one blob. A relative path is anchored to the REPO ROOT, not
# the process working directory. Sizing: the full corpus is ~18.3k files / ~8.6 GB
# as reported by NRB, of which the regulatory core is ~1,800 files / ~1.5 GB.
NRB_FILES_DIR=nrb_files

# --- RAG (department corpus ingestion; the WORKER reads these too) ---
# Corpus documents live here, separate from FILES_DIR. documents.storage_key is
# a RELATIVE key under this directory.
RAG_DOCS_DIR=rag_documents
# Native 2560 dims, MRL-truncated to 1536 (pgvector HNSW caps at 2000).
RAG_EMBED_MODEL=qwen3-embedding:4b-q8_0
RAG_EMBED_DIM=1536
RAG_EMBED_BATCH=32
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_OVERLAP_CHARS=200
RAG_INGEST_POLL_SECONDS=2.0
RAG_INGEST_STALE_MINUTES=10
# Keep well below STALE_MINUTES*60: a large PDF spends longer than the stale
# window in parse+embed, and the periodic heartbeat is what stops the sweep
# failing a healthy job.
RAG_INGEST_HEARTBEAT_SECONDS=30

# --- CORS (the frontend talks only to this gateway) ---
# "*" for local dev, or a comma-separated allowlist of origins for prod.
CORS_ORIGINS=*

# --- Image OCR (read_image) — BUILD-TIME ONLY, not an app setting -----------
# This is the ONE odd entry in this file: it is NOT read by app/config.py, and
# app.config uses extra="ignore" so it is silently discarded there. It is read by
# DOCKER COMPOSE variable interpolation (docker-compose.yml -> build.args), which
# takes values from your shell or from THIS file — never from .env.docker, which
# is `env_file`, i.e. the container's RUNTIME environment.
#
# Consequences, in order of how often they trip people up:
#   1. It only takes effect on a REBUILD. Setting it and restarting does nothing:
#        INSTALL_OCR=true docker compose build gateway nrb-runner
#   2. It is irrelevant to the venv. For local dev the equivalent is
#        .venv/bin/pip install -r requirements-ocr.txt
#   3. Left false (the default), image UPLOADS still work; only text extraction
#      is absent, and read_image answers
#        "ERROR: image OCR is not enabled on this deployment."
#
# ~270 MB (rapidocr + onnxruntime + opencv), CPU-only — it never touches the GPU,
# which belongs to Ollama. See docs/image-ocr.md.
INSTALL_OCR=false
